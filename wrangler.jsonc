{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cars-sound",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets"
	},
	"pages_build_output_dir": ".open-next",
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "sound"
		}
	]
}