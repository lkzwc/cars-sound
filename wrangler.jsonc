{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cars-sound",
	"compatibility_date": "2024-11-01", // 建议用回稳定日期
	"compatibility_flags": [
		"nodejs_compat",
		"node-compat-v2" 
	],
	"pages_build_output_dir": ".open-next",
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "sound"
		}
	]
}
